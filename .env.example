# Copy to .env only if you want to override the defaults.
AUDIOCITY_PUBLIC_URL=http://localhost:8080
AUDIOCITY_CORS_ORIGINS=http://localhost:8080
AUDIOCITY_ADMIN_EMAIL=admin@audiocity.local
# Leave blank to generate a password on first start and show it once in the logs.
AUDIOCITY_ADMIN_PASSWORD=
# Include Soundscaper's origin here if it is hosted on another origin.
# AUDIOCITY_CORS_ORIGINS=http://localhost:8080,https://soundscaper.org
# Registration is closed by default. Administrators can create accounts.
AUDIOCITY_REGISTRATION=false
# Change these together with Audacity's local service configuration.
AUDIOCITY_AUDACITY_CLIENT_ID=audiocity-desktop
AUDIOCITY_AUDACITY_CLIENT_SECRET=audiocity-local-desktop
# Quotas count each stored audio/project blob, including retained revisions.
AUDIOCITY_MAX_UPLOAD_BYTES=1073741824
AUDIOCITY_MAX_USER_BYTES=21474836480
