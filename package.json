{
  "name": "audiocity",
  "version": "0.1.0",
  "description": "Self-hosted audio uploads and Audacity-compatible project synchronization",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.5.0",
    "npm": "12.0.1"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/package-source.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "test:smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "license": "AGPL-3.0-only"
}
